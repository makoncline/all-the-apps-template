{
  "name": "all-the-apps-template",
  "private": true,
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@hello/server --filter=@hello/web",
    "web": "node ./scripts/run-surface.mjs web",
    "mac": "node ./scripts/run-surface.mjs mac",
    "ios": "node ./scripts/run-surface.mjs ios",
    "ui": "node ./scripts/run-surface.mjs ui",
    "cli": "node ./scripts/run-surface.mjs cli",
    "ui:sync": "pnpm --filter @hello/ui-tokens sync",
    "ui:check": "pnpm --filter @hello/ui-tokens check",
    "server": "pnpm --filter @hello/server dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @hello/db db:generate",
    "db:migrate": "pnpm --filter @hello/db db:migrate",
    "db:studio": "pnpm --filter @hello/db db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "tar@>=7.0.0 <7.5.21": "7.5.21",
      "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "undici@>=6.0.0 <6.28.1": "6.28.1",
